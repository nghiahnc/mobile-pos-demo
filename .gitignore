*.apk
*.aab
*.zip
*.jar
!gradle/wrapper/gradle-wrapper.jar
!.mvn/wrapper/maven-wrapper.jar

# Keep only reviewed documentation evidence from artifacts
/artifacts/*
!/artifacts/QA.md
!/artifacts/preview.png
!/artifacts/screenshots/
/artifacts/screenshots/*
!/artifacts/screenshots/*.png
