<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView style="@style/Text.POS.Eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/checkout_eyebrow"/>
            <TextView style="@style/Text.POS.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/checkout_heading"/>
            <TextView style="@style/Text.POS.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/checkout_caption"/>
            <com.google.android.material.card.MaterialCardView style="@style/Widget.POS.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" app:cardBackgroundColor="@color/soft_primary" app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:orientation="vertical">
                    <TextView style="@style/Text.POS.Eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/total"/>
                    <TextView android:id="@+id/amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="36sp" android:textColor="@color/primary" android:fontFamily="sans-serif-medium" android:layout_marginTop="4dp"/>
                    <TextView android:id="@+id/itemCount" style="@style/Text.POS.Body" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/method" android:textSize="17sp" android:textColor="@color/on_surface" android:fontFamily="sans-serif-medium"/>
            <RadioGroup android:id="@+id/methodGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/cashMethod" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/cash" android:checked="true"/>
                <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/cardMethod" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/card"/>
            </RadioGroup>
            <LinearLayout android:id="@+id/cashPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp">
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/cashInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/tendered_hint" app:boxCornerRadiusTopStart="16dp" app:boxCornerRadiusTopEnd="16dp" app:boxCornerRadiusBottomStart="16dp" app:boxCornerRadiusBottomEnd="16dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/cashInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLength="12" android:imeOptions="actionDone"/>
                </com.google.android.material.textfield.TextInputLayout>
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
                    <LinearLayout android:id="@+id/cashSuggestions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="8dp"/>
                </HorizontalScrollView>
                <TextView style="@style/Text.POS.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/change"/>
                <TextView android:id="@+id/changeAmount" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="24sp" android:textColor="@color/primary" android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/cardPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp" android:visibility="gone">
                <TextView style="@style/Text.POS.Eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/scenario_label"/>
                <RadioGroup android:id="@+id/scenarioGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp">
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/scenarioApproved" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/approve" android:checked="true"/>
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/scenarioDeclined" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/decline"/>
                    <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/scenarioConnection" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/connection_error"/>
                </RadioGroup>
                <TextView style="@style/Text.POS.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/card_notice" android:background="@drawable/bg_soft" android:padding="16dp"/>
            </LinearLayout>
            <TextView android:id="@+id/paymentError" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/error" android:background="@drawable/bg_error" android:padding="16dp" android:layout_marginTop="16dp" android:visibility="gone" android:accessibilityLiveRegion="assertive"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:paddingVertical="8dp" android:orientation="vertical" android:background="@color/surface">
        <TextView android:id="@+id/processingLabel" style="@style/Text.POS.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/processing" android:visibility="gone" android:accessibilityLiveRegion="polite"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/payButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pay"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/backButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/back"/>
    </LinearLayout>
</LinearLayout>
