<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="20dp">
            <TextView android:id="@+id/menuEyebrow" style="@style/Text.POS.Eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/menu_eyebrow"/>
            <TextView android:id="@+id/menuHeading" style="@style/Text.POS.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/menu_heading"/>
            <TextView android:id="@+id/menuCaption" style="@style/Text.POS.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/menu_caption"/>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/search_hint" app:boxCornerRadiusTopStart="16dp" app:boxCornerRadiusTopEnd="16dp" app:boxCornerRadiusBottomStart="16dp" app:boxCornerRadiusBottomEnd="16dp" app:startIconDrawable="@drawable/ic_search">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/searchInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:maxLines="1" android:imeOptions="actionSearch" android:textSize="14sp"/>
            </com.google.android.material.textfield.TextInputLayout>
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:fillViewport="true">
                <com.google.android.material.chip.ChipGroup android:id="@+id/categories" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingVertical="8dp" app:singleSelection="true" app:selectionRequired="true" app:singleLine="true" app:chipSpacingHorizontal="8dp"/>
            </HorizontalScrollView>
        </LinearLayout>
        <TextView android:id="@+id/catalogMessage" style="@style/Text.POS.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="16dp" android:visibility="gone" android:accessibilityLiveRegion="polite"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/retryButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:text="@string/retry" android:visibility="gone"/>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/products" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingHorizontal="14dp" android:paddingBottom="12dp" android:clipToPadding="false"/>
        <LinearLayout android:id="@+id/orderSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingHorizontal="20dp" android:paddingVertical="8dp" android:background="@color/surface">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/cartCount" style="@style/Text.POS.Eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/current_order"/>
                <TextView android:id="@+id/cartTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:textColor="@color/primary"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/viewCart" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/view_cart" app:icon="@drawable/ic_bag"/>
        </LinearLayout>
    </LinearLayout>
    <include android:id="@+id/inlineCart" layout="@layout/panel_cart" android:layout_width="340dp" android:layout_height="match_parent" android:visibility="gone"/>
</LinearLayout>
