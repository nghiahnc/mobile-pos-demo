<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/Widget.POS.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="6dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
        <FrameLayout android:id="@+id/artBackground" android:layout_width="match_parent" android:layout_height="86dp" android:background="@drawable/bg_soft">
            <ImageView android:id="@+id/productArt" android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="center" android:src="@drawable/ic_cup" android:importantForAccessibility="no"/>
        </FrameLayout>
        <TextView android:id="@+id/category" style="@style/Text.POS.Eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="11sp"/>
        <TextView android:id="@+id/productName" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:gravity="center_vertical" android:fontFamily="sans-serif-medium" android:textSize="16sp" android:textColor="@color/on_surface"/>
        <TextView android:id="@+id/note" style="@style/Text.POS.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="36dp" android:textSize="12sp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="8dp">
            <TextView android:id="@+id/price" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:textColor="@color/primary"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/addButton" style="@style/Widget.POS.SmallButton" android:layout_width="48dp" android:layout_height="48dp" android:text="@string/add_sign"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
