<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="20dp" android:background="@color/background">
    <TextView android:id="@+id/cartEyebrow" style="@style/Text.POS.Eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/current_order"/>
    <TextView android:id="@+id/cartHeading" style="@style/Text.POS.Heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/cart_heading" android:textSize="25sp"/>
    <TextView android:id="@+id/cartCaption" style="@style/Text.POS.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/cart_caption"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/addMore" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/continue_shopping"/>
    <LinearLayout android:id="@+id/emptyState" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:paddingVertical="24dp">
        <ImageView android:layout_width="64dp" android:layout_height="64dp" android:padding="12dp" android:src="@drawable/ic_bag" android:background="@drawable/bg_soft" android:importantForAccessibility="no"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cart_empty" android:textSize="20sp" android:textColor="@color/on_surface" android:gravity="center" android:layout_marginTop="16dp"/>
        <TextView style="@style/Text.POS.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cart_empty_detail" android:gravity="center" android:layout_marginTop="8dp"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/cartItems" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingVertical="8dp"/>
    <LinearLayout android:id="@+id/totalsPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="12dp">
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/outline"/>
        <TextView android:id="@+id/totalLabel" style="@style/Text.POS.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/total" android:layout_marginTop="16dp"/>
        <TextView android:id="@+id/totalAmount" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="32sp" android:textColor="@color/primary" android:fontFamily="sans-serif-medium"/>
        <TextView android:id="@+id/subtotalNote" style="@style/Text.POS.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/subtotal_note" android:textSize="12sp" android:layout_marginBottom="8dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/checkoutButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/checkout"/>
    </LinearLayout>
</LinearLayout>
