<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:gravity="center_horizontal">
        <ImageView android:id="@+id/statusIcon" android:layout_width="64dp" android:layout_height="64dp" android:padding="8dp" android:src="@drawable/ic_check" android:importantForAccessibility="no" android:background="@drawable/bg_soft" android:layout_marginTop="4dp"/>
        <TextView android:id="@+id/statusTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/success" android:textSize="24sp" android:textColor="@color/primary" android:fontFamily="sans-serif-medium" android:gravity="center" android:layout_marginTop="16dp"/>
        <TextView android:id="@+id/statusCaption" style="@style/Text.POS.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/receipt_caption" android:gravity="center" android:layout_marginTop="4dp"/>
        <com.google.android.material.card.MaterialCardView style="@style/Widget.POS.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/receipt_title" android:gravity="center" android:textSize="22sp" android:fontFamily="sans-serif-medium" android:textColor="@color/on_surface" android:letterSpacing="0.08"/>
                <TextView style="@style/Text.POS.Eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/receipt_demo" android:gravity="center" android:layout_marginTop="8dp"/>
                <TextView android:id="@+id/receiptMeta" style="@style/Text.POS.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="16dp" android:textSize="12sp"/>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/outline" android:layout_marginVertical="20dp"/>
                <LinearLayout android:id="@+id/receiptLines" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/outline" android:layout_marginVertical="16dp"/>
                <TextView style="@style/Text.POS.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/total"/>
                <TextView android:id="@+id/receiptTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="32sp" android:textColor="@color/primary" android:fontFamily="sans-serif-medium" android:layout_marginTop="4dp"/>
                <TextView android:id="@+id/paymentDetails" style="@style/Text.POS.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView style="@style/Text.POS.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/demo_notice" android:textSize="11sp" android:layout_marginTop="16dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/newOrder" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/new_order"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/viewHistory" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/see_history"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
